# Local development only. Never commit a real key.
AI_GATEWAY_API_KEY=your_gateway_key_here

# Optional: pin a different Jev model.
JEV_MODEL=typesafe-ai/jev-1.14.0

# Optional: minimum probability that current capabilities are sufficient.
JEV_CAPABILITY_THRESHOLD=0.6

# Optional: model used only when Jev requests a new renderer capability.
CAPABILITY_MODEL=anthropic/claude-sonnet-4.6

# Optional: conventional model used by the full-ArtSpec comparison path.
COMPARISON_MODEL=anthropic/claude-sonnet-4.6
